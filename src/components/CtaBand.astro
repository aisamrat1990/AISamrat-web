---
import { withBase } from '../lib/paths';
import { company } from '../data/site';

interface Props { title?: string; tone?: string }
const {
  title = 'Tell us what you’re working on.',
  tone = 'We’ll tell you honestly how we can help.',
} = Astro.props;
---
<section class="section cta" aria-labelledby="cta-title">
  <div class="wrap reveal">
    <span class="label live">Contact</span>
    <h2 class="h2" id="cta-title">{title}{' '}<span class="tone-2">{tone}</span></h2>
    <div class="cta-row">
      <a class="btn btn-shine" href={withBase('/contact/')}>Book a consultation</a>
      <a class="btn btn-secondary" href={`mailto:${company.email}`}>{company.email}</a>
    </div>
  </div>
</section>

<style>
  .h2 { margin: 20px 0 32px; max-width: 18em; }
</style>
