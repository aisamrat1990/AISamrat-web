---
import { withBase } from '../lib/paths';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-dark.png';
import Icon from './Icon.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(withBase(href));
---
<header class="nav">
  <div class="frame">
    <div class="wrap nav-inner">
      <a class="brand" href={withBase('/')} aria-label="AI Samrat home">
        <Image src={logo} alt="AI Samrat" height={56} loading="eager" fetchpriority="high" class="logo" />
      </a>
      <nav aria-label="Primary">
        <ul class="nav-links">
          {nav.map((item) => (
            <li><a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn btn-shine nav-cta" href={withBase('/contact/')} aria-current={isActive('/contact/') ? 'page' : undefined}>Talk to us</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-sheet" aria-label="Open menu">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>
<div class="sheet" id="menu-sheet" hidden>
  <nav aria-label="Mobile">
    {nav.map((item) => <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    <a href={withBase('/contact/')} aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
  </nav>
  <a class="btn btn-primary" href={withBase('/contact/')}>Talk to us</a>
</div>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50; height: var(--nav-h);
    background: rgba(0, 0, 0, .8);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav .frame { height: 100%; }
  .nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; }
  .brand :global(.logo) { height: 28px; width: auto; }
  .nav-links { display: none; gap: 4px; list-style: none; padding: 0; }
  .nav-links a {
    position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px;
    color: var(--text); font-size: 15px;
  }
  /* Hover/focus: a white underline grows in from the left and leaves to the right. Current page: a steady cyan one */
  .nav-links a::after {
    content: ""; position: absolute; left: 12px; right: 12px; bottom: 8px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform var(--dur) var(--ease);
  }
  .nav-links a:hover::after, .nav-links a:focus-visible::after { transform: scaleX(1); transform-origin: left; }
  .nav-links a[aria-current='page']::after { background: var(--accent); transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) { .nav-links a::after { transition: none; } }
  .nav-cta { display: none; min-height: 40px; padding: 0 20px; }
  /* Rim stays glossy but still; glints travel only while no shine CTA in the page is on screen (.is-live), or on hover/focus */
  .nav-cta { animation-play-state: paused; }
  .nav-cta.is-live, .nav-cta:hover, .nav-cta:focus-visible { animation-play-state: running; }
  .menu-btn {
    width: 44px; height: 44px; display: inline-grid; place-items: center;
    background: none; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--text); cursor: pointer;
  }
  .menu-btn :global(svg) { width: 20px; height: 20px; grid-area: 1 / 1; }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-btn[aria-expanded='true'] :global(.i-close) { display: block; }

  .sheet {
    position: fixed; inset: var(--nav-h) 0 0 0; z-index: 49; overflow-y: auto;
    background: var(--bg); padding: 24px var(--gutter) 40px; border-top: 1px solid var(--line);
  }
  .sheet nav a {
    display: flex; min-height: 56px; align-items: center;
    font-size: 24px; font-weight: 500; letter-spacing: -.01em; border-bottom: 1px solid var(--line);
  }
  .sheet nav a[aria-current='page'] { color: var(--accent); }
  .sheet .btn { margin-top: 24px; width: 100%; }

  @media (min-width: 900px) {
    .nav-links { display: flex; }
    .nav-cta { display: inline-flex; }
    .menu-btn, .sheet { display: none !important; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const sheet = document.getElementById('menu-sheet');
  if (btn && sheet) {
    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(Boolean(sheet.hidden)));
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sheet.hidden) { setOpen(false); btn.focus(); }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }

  // One moving shine per view: the nav CTA's glints hand over to the page's own shine CTA while that is on screen.
  // On the contact page itself the nav CTA stays still.
  const cta = document.querySelector<HTMLElement>('.nav-cta');
  if (cta && !cta.hasAttribute('aria-current')) {
    const onScreen = new Set<Element>();
    const update = () => cta.classList.toggle('is-live', onScreen.size === 0);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) onScreen.add(e.target);
        else onScreen.delete(e.target);
      }
      update();
    }, { rootMargin: '-64px 0px 0px 0px' }); // --nav-h: a CTA under the sticky nav doesn't count as on screen
    const shines = document.querySelectorAll('main .btn-shine');
    shines.forEach((el) => io.observe(el));
    if (!shines.length) update(); // otherwise the observer's first report sets it
  }
</script>
