---
import { Image } from 'astro:assets';
import photo from '../assets/people/dvs-prathap-babu.avif';
import { leader, company } from '../data/site';

interface Props { showBody?: boolean }
const { showBody = false } = Astro.props;
---
<section class="section" aria-labelledby="leader-title">
  <div class="wrap leader">
    <div class="portrait reveal">
      <Image
        src={photo}
        alt={`Portrait of ${leader.name}, ${leader.role} of ${company.name}`}
        widths={[320, 640]}
        sizes="320px"
        class="photo"
      />
    </div>
    <figure class="reveal">
      <span class="label" id="leader-title">From our Managing Director</span>
      <blockquote class="quote">{leader.quoteLead} <span class="tone-2">{leader.quoteTone}</span></blockquote>
      {showBody && <p class="body-2 more">{leader.body}</p>}
      <figcaption class="cite">
        <b>{leader.name}</b>
        <span>{leader.role}, {company.legalName}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .leader { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .leader { grid-template-columns: 320px 1fr; gap: 64px; } }
  .portrait {
    aspect-ratio: 4 / 5; max-width: 320px; overflow: hidden;
    border-radius: 12px; border: 1px solid var(--line-strong); background: var(--surface);
  }
  /* MASTER.md §7: photos are monochrome-treated so they sit inside the black-and-grey palette. */
  .portrait :global(.photo) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    filter: grayscale(1) contrast(1.05) brightness(.94);
  }
  .quote {
    font-size: clamp(22px, 2.4vw, 28px); line-height: 1.4; letter-spacing: -.01em;
    color: var(--text); margin: 24px 0 32px; max-width: 34em;
  }
  .quote .tone-2 { display: inline; }
  .more { margin: -8px 0 32px; }
  .cite { display: grid; gap: 2px; }
  .cite b { font-weight: 600; }
  .cite span { color: var(--text-3); font-size: 14px; }
</style>
