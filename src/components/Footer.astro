---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-dark.png';
import { company, services } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="frame">
    <div class="wrap">
      <div class="foot">
        <div>
          <a class="brand" href="/" aria-label="AI Samrat home">
            <Image src={logo} alt="AI Samrat" height={64} class="logo" />
          </a>
          <p class="blurb">Software, cloud, security and managed IT for businesses that want technology to simply work.</p>
        </div>
        <div>
          <h2 class="col-title">Services</h2>
          <ul>
            {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="col-title">Company</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/careers/">Careers</a></li>
            <li><a href="/contact/">Contact</a></li>
            {company.social.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="col-title">Office</h2>
          <address>{company.address.lines.join(', ')}</address>
          <p class="mail"><a class="inline-link" href={`mailto:${company.email}`}>{company.email}</a></p>
        </div>
      </div>
      <div class="legal">
        <span>© {year} {company.legalName}</span>
        <span>CIN {company.cin} · GST {company.gst}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .foot { display: grid; gap: 40px; padding: 64px 0 40px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .foot { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .foot { grid-template-columns: 1.4fr 1.1fr .8fr 1.2fr; } }
  .col-title {
    margin: 0 0 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase; color: var(--text-3);
  }
  ul { list-style: none; padding: 0; }
  .foot ul a {
    color: var(--text-2); display: inline-flex; min-height: 44px; align-items: center;
    transition: color var(--dur) var(--ease);
  }
  .foot ul a:hover { color: var(--text); }
  address { font-style: normal; color: var(--text-2); font-size: 15px; line-height: 1.7; max-width: 30ch; text-wrap: pretty; }
  .mail { margin-top: 12px; }
  .mail a { display: inline-flex; min-height: 44px; align-items: center; }
  .brand { display: inline-flex; min-height: 44px; align-items: center; }
  .brand :global(.logo) { height: 32px; width: auto; }
  .blurb { color: var(--text-3); font-size: 14px; margin-top: 16px; max-width: 32ch; }
  .legal {
    border-top: 1px solid var(--line); padding: 24px 0 32px;
    display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
    font-size: 13px; color: var(--text-3);
  }
</style>
